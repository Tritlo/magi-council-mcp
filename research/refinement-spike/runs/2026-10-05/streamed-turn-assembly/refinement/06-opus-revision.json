  "result": {
    "text": "type Event = { turnId: string; kind: string; [key: string]: unknown };\ntype Tool = { id: string; title: string; status: \"pending\" | \"running\" | \"completed\" | \"failed\"; output: string };\ntype Turn = { text: string; tools: Tool[]; stopReason: string | null };\n\nexport function assembleTurn(turnId: string, events: Event[]): Turn {\n  let text = \"\";\n  let stopReason: string | null = null;\n  const tools = new Map<string, Tool>();\n\n  for (const event of events) {\n    if (event.turnId !== turnId) continue;\n\n    if (event.kind === \"message\") {\n      const value = typeof event.text === \"string\" ? event.text : \"\";\n      if (event.mode === \"replace\") text = value;\n      else text += value;\n    } else if (event.kind === \"tool\") {\n      const id = event.id as string;\n      let tool = tools.get(id);\n      if (tool === undefined) {\n        tool = { id, title: \"\", status: \"pending\", output: \"\" };\n        tools.set(id, tool);\n      }\n      if (typeof event.title === \"string\") tool.title = event.title;\n      if (typeof event.status === \"string\") tool.status = event.status as Tool[\"status\"];\n      if (event.output === null) tool.output = \"\";\n      else if (typeof event.output === \"string\") {\n        if (event.outputMode === \"replace\") tool.output = event.output;\n        else tool.output += event.output;\n      }\n    } else if (event.kind === \"done\") {\n      stopReason = event.stopReason as string;\n      break;\n    }\n  }\n\n  return {\n    text,\n    tools: Array.from(tools.values(), (t) => ({ id: t.id, title: t.title, status: t.status, output: t.output })),\n    stopReason,\n  };\n}",
